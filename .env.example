# === Email (IMAP) nastavenia ===
# Pre Gmail: zapni "App Passwords" na https://myaccount.google.com/apppasswords
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_USER=tvoj@gmail.com
EMAIL_PASS=tvoje-app-heslo

# === Push notifikácie (ntfy.sh) ===
# 1. Nainštaluj appku "ntfy" z Google Play / App Store
# 2. V appke sa prihlás na topic (napr. "moje-platby-xyz123")
# 3. Rovnaký názov vlož sem:
NTFY_TOPIC=moje-platby-xyz123
NTFY_SERVER=https://ntfy.sh
